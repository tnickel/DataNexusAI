# DataNexus AI Environment Configuration Template
# Copy this file to .env or config.json and fill in your secure credentials

# API Keys for Agent Authentication & RBAC Governance
ADMIN_API_KEY=YOUR_ADMIN_API_KEY_HERE
ANALYST_API_KEY=YOUR_ANALYST_API_KEY_HERE
REPORTING_API_KEY=YOUR_REPORTING_API_KEY_HERE

# Database Connection (PostgreSQL or SQLite)
DATABASE_URL=postgresql://datanexus_user:datanexus_password@localhost:5432/datanexus_db

# Local Ollama LLM Service
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:14b

# Milvus Vector Database
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Ingestion Directories
INCOMING_DIR=./incoming
QUARANTINE_DIR=./quarantine
